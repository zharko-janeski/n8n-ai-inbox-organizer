      "id": "6e520e12-38f7-422f-98cb-14e232902354",
      "name": "Prepare Email"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an email triage engine for a busy professional. Classify the email into exactly one category.\n\nCategories:\n- urgent: a real person needs a response or action TODAY (deadlines, incidents, account/security, legal, personal asks). Marketing \"act now\" language is NOT urgent.\n- job-related: recruiters, applications, interviews, offers, hiring outreach.\n- invoice: bills, payment requests, receipts, subscription charges.\n- newsletter: marketing, promos, digests, automated notifications. No personal reply expected.\n- other: anything else.\n\nAlso produce:\n- priority: integer 1-5 (5 = act immediately, 1 = ignore)\n- summary: one sentence, max 25 words\n- draft_reply: ONLY if job-related or urgent from a real person; max 2 sentences, professional. Otherwise null.\n\nRespond with ONLY this JSON, no markdown fences, no extra text:\n{\"category\":\"urgent|newsletter|job-related|invoice|other\",\"priority\":0,\"summary\":\"\",\"draft_reply\":null}\n\nFROM: {{ $json.from }}\nSUBJECT: {{ $json.subject }}\nDATE: {{ $json.date }}\nBODY: {{ $json.body }}",
        "needsFallback": true
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        -800,
        336
      ],
      "id": "71b7fcf8-6872-41ca-9da2-a4b6b94b84a9",
      "name": "Classify Email"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash",
        "options": {
          "maxOutputTokens": 600,
          "temperature": 0.1
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        -672,
        528
      ],
      "id": "d42ce238-3032-479b-a407-cb3f89373d7c",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "dEA2XqXAqaIcT3cm",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Defensive parsing: LLM output is never fully trusted\nconst item = $input.first().json;\nconst raw = (item.text ?? item.output ?? '').toString();\n\nlet c;\ntry {\n  const cleaned = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/); // extract JSON even if model added chatter\n  c = JSON.parse(match ? match[0] : cleaned);\n} catch (e) {\n  c = { category: 'other', priority: 3, summary: (raw.slice(0, 180) || 'AI parse failed'), draft_reply: null };\n}\n\nconst allowed = ['urgent', 'newsletter', 'job-related', 'invoice', 'other'];\nc.category = allowed.includes(c.category) ? c.category : 'other';\nc.priority = Math.min(5, Math.max(1, Number(c.priority) || 3));\nc.summary = c.summary || item.subject || '(no summary)';\nif (!c.draft_reply || typeof c.draft_reply !== 'string') c.draft_reply = null;\nif (c.category === 'job-related' && !c.draft_reply) {\n  c.draft_reply = 'Thank you for reaching out — I received your email and will get back to you shortly.';\n}\n\nreturn [{ json: { ...item, classification: c } }];"
      },
