    {
      "parameters": {
        "jsCode": "// Normalizes ANY email shape (demo / old Gmail / new Gmail) into clean fields for the LLM\nconst item = $input.first().json;\n\n// ---------- helpers ----------\nfunction b64urlDecode(data) {\n  try { if (typeof Buffer !== 'undefined') return Buffer.from(data, 'base64url').toString('utf8'); } catch (e) {}\n  try {\n    const b64 = String(data).replace(/-/g, '+').replace(/_/g, '/');\n    return decodeURIComponent(escape(atob(b64)));\n  } catch (e) { return ''; }\n}\n\nfunction cleanText(raw) {\n  return String(raw || '')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, 3000);\n}\n\n// ---------- 1) DEMO data (Sample Email Set node: flat fields, no headers/payload) ----------\nif (!item.headers && !item.payload) {\n  return [{ json: {\n    messageId: item.messageId || 'demo-001',\n    threadId: item.threadId || 'demo-001',\n    from: item.from || 'unknown@example.com',\n    subject: item.subject || '(no subject)',\n    date: item.date || new Date().toISOString(),\n    body: cleanText(item.body),\n    snippet: item.snippet || ''\n  }}];\n}\n\n// ---------- 2) REAL data ----------\nlet from = '', subject = '', date = '', rawBody = '';\n\nif (item.payload) {\n  // OLD Gmail format: payload.headers = ARRAY of {name, value}\n  const getHeader = (name) => {\n    const h = (item.payload.headers || []).find(x => x.name && x.name.toLowerCase() === name.toLowerCase());\n    return h ? h.value : '';\n  };\n  from = getHeader('From');\n  subject = getHeader('Subject');\n  date = getHeader('Date');\n  if (item.payload.body?.data) rawBody = b64urlDecode(item.payload.body.data);\n  else for (const part of item.payload.parts || []) {\n    if (part.mimeType === 'text/plain' && part.body?.data) { rawBody = b64urlDecode(part.body.data); break; }\n  }\n} else if (item.headers) {\n  // NEW Gmail format (your n8n version): headers = flat OBJECT\n  const get = (name) => {\n    const v = item.headers[name.toLowerCase()] ?? item.headers[name] ?? '';\n    return String(v).replace(new RegExp('^\\\\s*' + name + '\\\\s*:\\\\s*', 'i'), '').trim();\n  };\n  from = get('From');\n  subject = get('Subject');\n  date = get('Date');\n  // body could hide in several places — try them all, snippet as last resort\n  if (typeof item.body === 'string') rawBody = item.body;\n  else if (item.body?.data) rawBody = b64urlDecode(item.body.data);\n  else if (typeof item.text === 'string') rawBody = item.text;\n}\n\nrawBody = rawBody || item.snippet || '';\n\nreturn [{ json: {\n  messageId: item.id || item.messageId,\n  threadId: item.threadId,\n  from: from || 'unknown@example.com',\n  subject: subject || '(no subject)',\n  date,\n  body: cleanText(rawBody),\n  snippet: item.snippet || ''\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
